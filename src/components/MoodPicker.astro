<section aria-labelledby="h-mood">
    <h2 id="h-mood">¿Cómo te sientes hoy?</h2>
    <form class="ask" id="askForm">
      <input id="moodText" type="text" autocomplete="off" placeholder="Ej: cansada pero feliz" aria-label="Cómo te sientes">
      <button class="btn primary" type="submit">Recomiéndame</button>
    </form>
    <p class="hint" id="hint">O toca uno:</p>
    <div class="chips" id="chips"></div>
  </section>
