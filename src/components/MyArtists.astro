<section aria-labelledby="h-art">
    <h2 id="h-art">Tus artistas</h2>
    <p class="hint">Agrega a quien te guste y también te saldrán sus canciones. Se guardan en este teléfono.</p>
    <form class="ask" id="artForm">
      <input id="artText" type="text" autocomplete="off" placeholder="Ej: Karol G, Olivia Rodrigo…" aria-label="Agregar artista">
      <button class="btn primary" type="submit">Agregar</button>
    </form>
    <div class="tags" id="tags"></div>
    <p class="hint" id="artHint"></p>
    <div><button class="again" id="again" type="button">Descubrir más artistas</button></div>
  </section>
