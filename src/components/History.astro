<section aria-labelledby="h-hist">
    <h2 id="h-hist">Tu historial</h2>
    <p class="hint" id="histMood"></p>
    <ol class="hist" id="histList"></ol>
    <div class="hist-actions">
      <button class="again" id="histClear" type="button">Borrar mi historial</button>
      <span id="histConfirm" hidden>¿Seguro? Se borran tus ánimos, canciones y artistas descartados.
        <button class="again strong" id="histYes" type="button">Sí, borrar</button>
        <button class="again" id="histNo" type="button">No</button>
      </span>
    </div>
  </section>
