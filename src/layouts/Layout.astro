---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'La radio de Margarita',
  description = 'Dime cómo te sientes y te pongo la canción justa.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffeef5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500;1,600;1,700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,800&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
